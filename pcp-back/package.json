{
	"name": "customprompt",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"local": "npm-run-all -p local:docker:up -r local:wait local:dev",
		"local:docker:up": "dotenv -e .env -- docker-compose up",
		"local:docker:down": "dotenv -e .env -- docker-compose down",
		"local:docker:build": "dotenv -e .env -- docker-compose build --no-cache",
		"local:wait": "wait-on tcp:$POSTGRES_PORT tcp:$REDIS_PORT tcp:$MLFLOW_PORT",
		"local:dev": "nest start --watch",
		"dev": "dotenv -e .env -- nest start --watch",
		"prod:start": "node dist/main",
		"build": "nest build",
		"typeorm": "ts-node ./node_modules/typeorm/cli",
		"typeorm:run-migrations": "npm run typeorm migration:run -- -d orm.config.ts",
		"typeorm:generate-migration": "npm run typeorm -- -d orm.config.ts migration:generate ./migrations/$npm_config_name",
		"typeorm:create-migration": "npm run typeorm -- migration:create ./migrations/$npm_config_name",
		"typeorm:revert-migration": "npm run typeorm -- -d orm.config.ts migration:revert",
		"seed": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d orm.config.ts",
		"test": "jest",
		"prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.{ts,js}\"",
		"lint": "eslint \"{src,apps,libs,test,migrations}/**/*.{ts,js}\" --fix",
		"prepare": "husky"
	},
	"dependencies": {
		"@dqbd/tiktoken": "^1.0.22",
